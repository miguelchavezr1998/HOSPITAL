<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.*?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.hospital.controller.HistorialController">

    <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="scroll-pane">
        <VBox spacing="0" styleClass="content-body">

        <VBox spacing="0">
            <padding><Insets bottom="20"/></padding>
            <FlowPane alignment="CENTER_LEFT" hgap="16" vgap="12" styleClass="responsive-toolbar">
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label text="Historial Clinico" styleClass="content-title"/>
                    <Label text="Registro clinico de consultas y tratamientos" styleClass="content-subtitle"/>
                </VBox>
                <Button fx:id="btnNuevoHistorial" text="+ Nuevo Registro" styleClass="btn-primary"
                        onAction="#handleNuevo" prefHeight="40"/>
            </FlowPane>
        </VBox>

        <!-- Busqueda -->
        <FlowPane alignment="CENTER_LEFT" hgap="12" vgap="10" styleClass="responsive-toolbar">
            <padding><Insets bottom="16"/></padding>
            <TextField fx:id="txtBuscar" promptText="Buscar por paciente, diagnostico o tratamiento..."
                       prefHeight="40" prefWidth="400" styleClass="text-field"/>
            <Button text="Buscar" styleClass="btn-outline" onAction="#handleBuscar" prefHeight="40"/>
            <Button text="Limpiar" styleClass="btn-secondary" onAction="#handleLimpiar" prefHeight="40"/>
            <Label fx:id="lblTotal" text="Total: 0 registros" style="-fx-text-fill: #64748b; -fx-font-size: 13px;"/>
        </FlowPane>

        <!-- Tabla historial -->
        <VBox fx:id="tableCard" styleClass="card" VBox.vgrow="ALWAYS">
            <padding><Insets top="0" right="0" bottom="0" left="0"/></padding>
            <TableView fx:id="tableHistorial" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colFecha" text="Fecha" prefWidth="110"/>
                    <TableColumn fx:id="colPaciente" text="Paciente" prefWidth="160"/>
                    <TableColumn fx:id="colDoctor" text="Doctor" prefWidth="160"/>
                    <TableColumn fx:id="colDiagnostico" text="Diagnostico" prefWidth="180"/>
                    <TableColumn fx:id="colTratamiento" text="Tratamiento" prefWidth="180"/>
                    <TableColumn fx:id="colPresion" text="Presion" prefWidth="90"/>
                    <TableColumn fx:id="colTemp" text="Temp." prefWidth="80"/>
                    <TableColumn fx:id="colAcciones" text="Acciones" prefWidth="140"/>
                </columns>
                <placeholder>
                    <Label text="No hay registros clinicos" style="-fx-text-fill: #94a3b8;"/>
                </placeholder>
            </TableView>
        </VBox>

        <!-- Formulario historial -->
        <VBox fx:id="formPanel" visible="false" managed="false" spacing="16" styleClass="card">
            <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

            <HBox alignment="CENTER_LEFT">
                <Label fx:id="formTitle" text="Nuevo Registro" styleClass="card-title" HBox.hgrow="ALWAYS"/>
                <Button text="X" styleClass="btn-secondary" onAction="#handleCerrarForm" prefWidth="32" prefHeight="32"/>
            </HBox>

            <FlowPane hgap="16" vgap="12" styleClass="responsive-form">

                <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Paciente *" styleClass="form-label"/>
                    <ComboBox fx:id="cbPaciente" prefHeight="38" promptText="Seleccionar paciente"/>
                </VBox>

                <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Doctor *" styleClass="form-label"/>
                    <ComboBox fx:id="cbDoctor" prefHeight="38" promptText="Seleccionar doctor"/>
                </VBox>

                <VBox spacing="4" GridPane.columnIndex="2" GridPane.rowIndex="0">
                    <Label text="Fecha" styleClass="form-label"/>
                    <DatePicker fx:id="dpFecha" prefHeight="38"/>
                </VBox>

                <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="3">
                    <Label text="Diagnostico *" styleClass="form-label"/>
                    <ComboBox fx:id="cbDiagnostico" prefHeight="38" maxWidth="Infinity"
                              promptText="Seleccionar o escribir diagnostico CIE-10"/>
                </VBox>

                <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="3">
                    <Label text="Tratamiento *" styleClass="form-label"/>
                    <TextArea fx:id="txtTratamiento" prefHeight="80" promptText="Tratamiento prescrito..."/>
                </VBox>

                <!-- Signos Vitales -->
                <Label text="Signos Vitales" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #5252d4;"
                       GridPane.columnIndex="0" GridPane.rowIndex="3" GridPane.columnSpan="3"/>

                <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="4">
                    <Label text="Presion Arterial" styleClass="form-label"/>
                    <TextField fx:id="txtPresion" prefHeight="38" promptText="Ej: 120/80"/>
                </VBox>

                <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="4">
                    <Label text="Temperatura" styleClass="form-label"/>
                    <TextField fx:id="txtTemperatura" prefHeight="38" promptText="Ej: 36.5"/>
                </VBox>

                <VBox spacing="4" GridPane.columnIndex="2" GridPane.rowIndex="4">
                    <Label text="Pulso" styleClass="form-label"/>
                    <TextField fx:id="txtPulso" prefHeight="38" promptText="Ej: 72"/>
                </VBox>

                <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="5">
                    <Label text="Peso (kg)" styleClass="form-label"/>
                    <TextField fx:id="txtPeso" prefHeight="38" promptText="Ej: 70"/>
                </VBox>

                <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="5">
                    <Label text="Estatura (cm)" styleClass="form-label"/>
                    <TextField fx:id="txtEstatura" prefHeight="38" promptText="Ej: 175"/>
                </VBox>

                <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="6" GridPane.columnSpan="3">
                    <Label text="Notas adicionales" styleClass="form-label"/>
                    <TextArea fx:id="txtNotas" prefHeight="70" promptText="Observaciones clinicas..."/>
                </VBox>
            </FlowPane>

            <HBox spacing="12" alignment="CENTER_RIGHT">
                <padding><Insets top="16" right="0" bottom="0" left="0"/></padding>
                <Button text="Cancelar" styleClass="btn-secondary" onAction="#handleCerrarForm"/>
                <Button fx:id="btnGuardar" text="Guardar Registro" styleClass="btn-success"
                        onAction="#handleGuardar"/>
            </HBox>
        </VBox>
        </VBox>
    </ScrollPane>
</StackPane>
